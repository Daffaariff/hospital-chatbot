# LLM: anthropic (default) or openai (also OpenRouter / Ollama / vLLM via OPENAI_BASE_URL)
LLM_PROVIDER=anthropic
ANSWER_MODEL=claude-opus-5-5
ROUTER_MODEL=claude-haiku-5-5
# Second-opinion check of non-numeric claims (adds ~1s per answer)
CLAIM_CHECK=true
CHECK_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# Max LLM calls in flight at once; extra requests wait briefly instead of hitting provider rate limits
LLM_MAX_CONCURRENCY=8

# --- OpenAI instead of Claude (example model ids; use any your account has)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANSWER_MODEL=gpt-5
# ROUTER_MODEL=gpt-5-mini
# CHECK_MODEL=gpt-5-mini

# --- OpenRouter (any model it hosts; ids look like "vendor/model")
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=<openrouter key>
# ANSWER_MODEL=openai/gpt-5
# ROUTER_MODEL=openai/gpt-5-mini
# CHECK_MODEL=openai/gpt-5-mini
# Models without JSON-schema output support: switch to plain JSON mode (schema goes in the prompt)
# OPENAI_JSON_MODE=object

# Comma-separated bearer keys for /api/v1/admin/* (refresh, unanswered, leads). Empty = admin disabled.
API_KEYS=

# Voice mode (optional)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Public hostname Caddy serves (docker compose)
DOMAIN=localhost
